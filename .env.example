# Base URL of the rockets-and-space FastAPI service (AI Assistant chat backend).
# Local dev default assumes rockets-and-space's docker compose stack is running
# on this machine (see ../rockets-and-space/docker-compose.yml).
REACT_APP_AI_API_URL=http://localhost:8000

# CloudFront distribution in front of s3://<your-bucket>/ui-assets/ -- static
# UI images (flags, agency logos, planets, etc). src/constants/assetUrls.js
# falls back to the project's own CDN domain if this isn't set, so it's only
# needed if you've stood up your own bucket/distribution.
REACT_APP_ASSET_CDN_URL=https://d2m7uc5eskrsnq.cloudfront.net
